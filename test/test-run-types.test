import test from "node:test";
import assert from "node:assert/strict";
import { getFailedTitles, summarizeRun } from "../dist/test-run.js";

const results = [
  { id: "R-1", title: "Checkout succeeds", status: "passed", durationMs: 280 },
  {
    id: "R-2",
    title: "Declined card shows message",
    status: "failed",
    durationMs: 95,
  },
  { id: "R-3", title: "Guest checkout", status: "skipped" },
];

test("summarizes typed results", () => {
  assert.deepEqual(summarizeRun(results), {
    total: 3,
    passed: 1,
    failed: 1,
    skipped: 1,
    passRate: 1 / 3,
  });
});

test("returns failed titles in input order", () => {
  assert.deepEqual(getFailedTitles(results), ["Declined card shows message"]);
});

test("uses null pass rate for an empty run", () => {
  assert.deepEqual(summarizeRun([]), {
    total: 0,
    passed: 0,
    failed: 0,
    skipped: 0,
    passRate: null,
  });
});
